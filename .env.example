# Port d'écoute de l'API
PORT=4000

# Clé de chiffrement de la chaîne de connexion SQL Server (AES-256-GCM).
# Générer une valeur robuste, ex : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRISMA_CONFIG_KEY=change-me-32-bytes-base64-or-longer-passphrase

# Secret de signature des JWT de session
JWT_SECRET=change-me-please-a-long-random-secret

# Durée de validité du token (ex : 12h, 7d)
JWT_EXPIRES_IN=12h

# Origine autorisée pour CORS (URL du front Vite en dev)
CLIENT_ORIGIN=http://localhost:5173
